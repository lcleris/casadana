{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".agents/**",
    ".claude/skills/**",
    "docs/**",
    "**/*.md",
    "apps/api/**",
    "packages/api/src/generated/**",
    "apps/web/src/routeTree.gen.ts",
    ".fallowrc.json",
    "fallow-suppressions.json",
    "oxlint-suppressions.json"
  ],
  "semi": false,
  "tabWidth": 2,
  "sortImports": true,
  "sortTailwindcss": true
}
