{
  "name": "@casa-dana/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run paraglide && tsc && vite build",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "paraglide:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --watch",
    "translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@casa-dana/api": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@inlang/cli": "^3.4.4",
    "@inlang/paraglide-js": "^2.29.1",
    "@inlang/plugin-m-function-matcher": "^2.3.4",
    "@inlang/plugin-message-format": "^4.5.4",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
