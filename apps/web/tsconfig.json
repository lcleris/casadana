{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // TS 7 loads no @types package unless listed; bun:test needs these.
    "types": ["bun"],
    // Matches packages/api/tsconfig.json. Without it, `tsc` type-checks every
    // dependency's .d.ts and the build fails on upstream issues we cannot fix
    // (@tanstack/router-core, lucide-react, vite/client).
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
